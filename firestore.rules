rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() && (
        request.auth.token.email == 'johanderjca@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master')
      );
    }

    // Permiso por módulo: el master siempre tiene todos; un usuario normal necesita
    // permisos.<modulo> == true en su propio doc de users/{uid} (espejo del que se ve/edita
    // en Usuarios del panel, ahí vive en vendedores/{id} por email/uid, no por uid como doc id).
    // .get(key, default) evita fallar si el campo permisos no existe en la cuenta.
    function tienePermiso(modulo) {
      return isMaster() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permisos', {}).get(modulo, false) == true
      );
    }

    // ── users ── perfil de cada cuenta (uid, email, role, photoURL)
    // el master crea la cuenta de otros usuarios (Usuarios en el panel) además de la propia
    match /users/{uid} {
      allow read:   if isMaster() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isMaster() || (isSignedIn() && request.auth.uid == uid);
      // el propio usuario puede actualizar su perfil (ej. foto) pero NO su rol;
      // solo el master puede cambiar el campo role (ver cambiarRol en el panel)
      allow update: if isMaster() ||
        (isSignedIn() && request.auth.uid == uid &&
         request.resource.data.role == resource.data.role);
      allow delete: if isMaster();
    }

    // ── vendedores ── ficha de cada usuario (nombre, email, permisos por módulo, activo)
    // ya no hay auto-registro: solo el master crea usuarios desde el panel.
    // lectura abierta a cualquier logueado: el login de cada usuario hace un
    // get() sin filtro sobre toda la coleccion para vincular su cuenta (uid/email),
    // y Firestore no puede permitir eso con una regla restringida por campo
    match /vendedores/{id} {
      allow read:   if isSignedIn();
      allow create: if isMaster();
      // el propio usuario puede vincular su uid/normalizar su email en su ficha (login);
      // el master puede editar cualquier ficha (incluyendo permisos/activo)
      allow update: if isMaster() ||
        (isSignedIn() && (resource.data.email == request.auth.token.email || resource.data.uid == request.auth.uid));
      allow delete: if isMaster();
    }

    // ── gastos ── solo el master los ve y gestiona
    match /gastos/{id} {
      allow read, write: if isMaster();
    }

    // ── ventas ── cada vendedor solo ve/crea las suyas; el master ve/gestiona todas
    match /ventas/{id} {
      allow read:   if isMaster() || (isSignedIn() && resource.data.vendedorId == request.auth.uid);
      allow create: if isMaster() || (isSignedIn() && request.resource.data.vendedorId == request.auth.uid);
      allow update, delete: if isMaster();
    }

    // ── tiendas ── cualquier usuario logueado puede leer los nombres;
    // solo el master crea/edita/borra tiendas
    match /tiendas/{id} {
      allow read:  if isSignedIn();
      allow write: if isMaster();
    }

    // ── cierres, links, productos ── gateadas por el permiso de su módulo, no solo "logueado"
    match /cierres/{id}    { allow read, write: if tienePermiso('cierre'); }
    match /links/{id}      { allow read, write: if tienePermiso('accesos'); }
    match /productos/{id}  { allow read, write: if tienePermiso('ganadores'); }

    // ── proveedores ── ficha de cada proveedor, gateada por su permiso
    match /proveedores/{id} { allow read, write: if tienePermiso('proveedores'); }

    // ── campanas ── Planeacion de Campanas, solo master
    match /campanas/{id}   { allow read, write: if isMaster(); }

    // ── contabilidad (partida doble, manual) ── gateada por el permiso de Contabilidad
    match /cuentas_contables/{id}  { allow read, write: if tienePermiso('contabilidad'); }
    match /asientos_contables/{id} { allow read, write: if tienePermiso('contabilidad'); }

    // ── configuracion ── plantilla compartida del checklist de Contenido; la lee quien
    // tenga acceso a Productos, solo el master la edita
    match /configuracion/{id} {
      allow read:  if tienePermiso('ganadores');
      allow write: if isMaster();
    }

    // cualquier otra coleccion no listada: denegada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
